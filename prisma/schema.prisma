// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//================================
// USER TABLE
//================================
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  role     Role    @default(USER)
  emailVerified Boolean @default(false)

  profileImageId String? @unique
  profileImage   Image?  @relation("UserProfileImage", fields: [profileImageId], references: [id])

  accounts Account[]
  sessions Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]

  bookings Booking[]
  reviews  Review[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  ip           String?
  userAgent    String?
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id  String @id @default(uuid())
  token String @unique
  userId  String
  expiresAt DateTime

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//================================
// TOUR TABLES
//================================
model Tour {
  id             String @id @default(uuid())
  name           String
  slug           String @unique
  joinerCapacity Int    @default(12)

  description  String
  highlights   String[]
  inclusions   String[]
  exclusions   String[]
  location     String
  durationDays Int? //For day tours, this will be 1 day. For package tours, this will be the total duration of the tour in days.
  capacityMode CapacityMode @default(EXCLUSIVE)
  type         TourType     @default(DAY)
  timezone     String       @default("Asia/Manila")

  schedules          TourScheduleOption[] //For package tours, this will be empty and the schedule will be determined by the itinerary.
  itinerary          Itinerary?
  images             Image[]
  pricing            TourPricing[]
  reviews            Review[]
  availability       TourAvailability[]
  cancellationPolicy CancellationPolicy?
  capacity           TourDailyCapacity[]
  
  bookings           Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//================================
// AVAILABILITY TABLE
//================================
model TourAvailability {
  id   String   @id @default(uuid())
  date DateTime

  isClosed Boolean @default(false) //If true, the tour is not available for booking on this date. This can be used for maintenance, fully booked dates, etc.
  tourId   String
  reason   String? //e.g. "Maintenance", "Fully Booked", etc.
  tour     Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tourId, date])
}

//===============================
// TOUR DAILY CAPACITY
//===============================
model TourDailyCapacity {
  id String @id @default(uuid())

  date     DateTime
  capacity Int
  booked   Int      @default(0) // current used slots

  scheduleId String?
  schedule   TourScheduleOption? @relation(fields: [scheduleId], references: [id])

  scheduleKey String

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tourId, date, scheduleKey])
}

//================================
// SCHEDULE TABLE
//================================
model TourScheduleOption {
  id String @id @default(uuid())

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  label     String
  startTIme String?
  endTime   String?

  capacity Int?

  schedules TourDailyCapacity[]
  bookings  Booking[]

  createdAt DateTime @default(now())
}

//================================
// ITINERARY TABLES
//================================
model Itinerary {
  id   String         @id @default(uuid())
  days ItineraryDay[]

  tourId String @unique
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItineraryDay {
  id        String  @id @default(uuid())
  dayNumber Int
  title     String?

  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  items ItineraryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItineraryItem {
  id          String  @id @default(uuid())
  time        String //Can be a specific time (e.g. 9:00 AM) or a time range (e.g. 9:00 AM - 11:00 AM) or a general time of day (e.g. Morning, Afternoon, Evening)
  title       String
  description String?

  order Int

  dayId String
  day   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//================================
// IMAGE TABLES
//================================
model Image {
  id         String  @id @default(uuid())
  url        String
  publicId   String
  isFeatured Boolean @default(false)

  type   ImageType
  status ImageStatus @default(TEMP) //for cleanup

  tourId String?

  userProfile User? @relation("UserProfileImage")

  tour      Tour?    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

//================================
// PRICING TABLES
//================================
model TourPricing {
  id String @id @default(uuid())

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  pricingType PricingType

  pricingModel PricingModel

  price Float

  minGroupSize Int
  maxGroupSize Int

  createdAt DateTime @default(now())
}

model CancellationPolicy {
  id          String @id @default(uuid())
  description String

  freeCancellationHours Int //Number of hours before the tour start time that cancellation is free. For example, if this is 24, then cancellation is free if done at least 24 hours before the tour start time.
  partialRefundHours    Int //Number of hours before the tour start time that partial refund is given. For example, if this is 12, then partial refund is given if cancellation is done at least 12 hours before the tour start time but less than 24 hours before the tour start time.
  refundPercentage      Int //Percentage of the total price that will be refunded for cancellations that qualify for partial refund. For example, if this is 50, then 50% of the total price will be refunded for cancellations that qualify for partial refund.

  tourId String @unique
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//================================
// BOOKING TABLES
//================================
model Booking {
  id String @id @default(uuid())

  userId String
  tourId String

  pricingType  PricingType
  participants Int
  notes        String?

  totalPrice Float
  status     BookingStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime?

  rescheduleCount    Int       @default(0)
  lastRescheduleDate DateTime?
  canceledAt         DateTime?

  expiresAt DateTime?

  refundAmount Float?

  refundStatus RefundStatus?

  scheduleId String? //For package tours, this will be null and the schedule will be determined by the itinerary.

  payment Payment?

  user     User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  tour     Tour                @relation(fields: [tourId], references: [id], onDelete: Restrict)
  schedule TourScheduleOption? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  logs BookingAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId, startDate, endDate])
}

//================================
//BOOKING HISTORY TABLES
//================================
model BookingAuditLog {
  id            String        @id @default(uuid())
  bookingId     String
  actorId       String //userid
  actorType     Role //USER or ADMIN
  action        BookingAction //e.g. CREATED, RESCHEDULED, CANCELLED
  previousValue Json? //e.g. previous start date for rescheduling, or previous status for cancellation
  newValue      Json? //e.g. new start date for rescheduling, or new status for cancellation
  reason        String? //for cancellation or rescheduling

  timestamp DateTime @default(now())

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

//================================
// PAYMENT TABLES
//================================
model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  xenditInvoiceId String
  invoiceUrl      String
  status          PaymentStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

//================================
// REVIEW TABLES
//================================
model Review {
  id         String @id @default(uuid())
  starRating Int
  comment    String
  // imageIds    String[]

  userId String
  tourId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hotel {
  id          String   @id @default(uuid())
  name        String   @unique
  address     String
  description String
  amenities   String[]

  rooms    Room[]
  policies Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String
  baseRate        Float
  maxOccupancy    Int
  roomType        RoomType
  bedType         BedType
  extraPersonRate Int

  hotelId String

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Policy {
  id           String @id @default(uuid())
  checkIn      String
  checkOut     String
  cancellation String
  child        String
  reservation  String
  pet          String

  hotelId String

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//================================
// ENUMS
//================================
enum RoomType {
  STUDIO
  ENTIRE_HOUSE
  LUXURY
  FAMILY
}

enum BookingAction {
  CREATED
  RESCHEDULED
  CANCELLED
}

enum BedType {
  DOUBLE
  KING
  QUEEN
}

enum TourType {
  DAY
  PACKAGE
}

enum CapacityMode {
  EXCLUSIVE
  SHARED
  MIXED
}

enum TourSchedule {
  MORNING
  AFTERNOON
  EVENING
  WHOLE_DAY
}

enum PricingType {
  JOINER
  PRIVATE
}

enum PricingModel {
  PER_PERSON
  PER_GROUP
}

enum Role {
  USER
  ADMIN
}

enum ImageType {
  TOUR
  ITINERARY
  PROFILE
}

enum ImageStatus {
  TEMP
  ACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}
