// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String?
  googleId String?  @unique
  name    String?
  role     Role     @default(USER)

  bookings Booking[]
  image     Image[]
}

model Tour {
  id      String        @id @default(uuid())
  name    String
  slug    String        @unique
  joinerCapacity Int @default(12)
  images  Image[]
  pricing TourPricing[]
  bookings Booking[]
  itineraries Itinerary[]
}

model Itinerary {
  id      String      @id @default(uuid())
  title   String
  activities  String[]
  destinations  String[]

  tourId  String
  tour    Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
}


model Image {
  id          String      @id @default(uuid())
  url         String
  publicId    String
  isFeatured  Boolean     @default(false)

  type        ImageType
  status      ImageStatus @default(TEMP) //for cleanup

  tourId      String?
  userId      String?

  tour        Tour?       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
}

model TourPricing {
  id           String   @id @default(uuid())
  pricingType  PricingType
  minGroupSize Int
  maxGroupSize Int
  price        Int
  isGroupPrice Boolean  @default(false)
  tourId       String
  tour         Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  tourId    String

  pricingType PricingType
  participants Int

  total     Int
  startDate DateTime
  endDate   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tourId, startDate])
  @@index([tourId, pricingType, startDate])
  @@index([userId, createdAt])
}

enum PricingType {
  joiner
  private
}

enum Role {
  USER
  ADMIN
}

enum ImageType {
  TOUR
  ITINERARY
  PROFILE
}

enum ImageStatus {
  TEMP
  ACTIVE
}

