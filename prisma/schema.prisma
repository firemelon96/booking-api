// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String?
  googleId String?  @unique
  name    String?
  role     Role     @default(USER)

  profileImageId  String? @unique
  profileImage  Image? @relation("UserProfileImage",fields: [profileImageId], references: [id])

  bookings Booking[]
  reviews   Review[]
}

model Tour {
  id      String        @id @default(uuid())
  name    String
  slug    String        @unique
  joinerCapacity Int @default(12)

  description String
  highlights String[]
  inclusions String[]
  exclusions String[]
  location    String
  durationDays    Int? //For day tours, this will be null. For package tours, this will be the total duration of the tour in days.
  types       TourType  @default(DAY) 
  timezone  String @default("Asia/Manila") 

  schedules   TourScheduleOption[] //For package tours, this will be empty and the schedule will be determined by the itinerary.
  itinerary Itinerary?
  images  Image[]
  pricing TourPricing[]
  bookings Booking[]
  reviews Review[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model TourScheduleOption {
  id      String      @id @default(uuid())
  schedule TourSchedule 

  tourId  String
  tour    Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)

  bookings Booking[] //For package tours, this will be empty and the schedule will be determined by the itinerary.

  createdAt DateTime    @default(now())
}

model Itinerary {
  id      String      @id @default(uuid())
  days    ItineraryDay[]

  tourId  String  @unique
  tour    Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model ItineraryDay {
  id          String      @id @default(uuid())
  dayNumber   Int
  title       String?

  itineraryId String
  itinerary   Itinerary    @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  items       ItineraryItem[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model ItineraryItem {
  id          String      @id @default(uuid())
  time   String //Can be a specific time (e.g. 9:00 AM) or a time range (e.g. 9:00 AM - 11:00 AM) or a general time of day (e.g. Morning, Afternoon, Evening)
  title       String
  description String?

  order       Int

  dayId String
  day   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Image {
  id          String      @id @default(uuid())
  url         String
  publicId    String
  isFeatured  Boolean     @default(false)

  type        ImageType
  status      ImageStatus @default(TEMP) //for cleanup

  tourId      String?
 
  userProfile User? @relation("UserProfileImage")

  tour        Tour?       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
}

model TourPricing {
  id           String   @id @default(uuid())
  pricingType  PricingType
  minGroupSize Int
  maxGroupSize Int
  price        Float
  tourId       String
  isGroupPrice Boolean @default(false) //For joiner tours, this will be true. For private tours, this will be false.
  tour         Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  tourId    String

  pricingType PricingType
  participants Int
  notes       String?

  totalPrice     Float
  status         BookingStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime?

  scheduleId String? //For package tours, this will be null and the schedule will be determined by the itinerary.

  payment Payment?
  
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Restrict)
  schedule TourScheduleOption? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId, startDate])
  @@index([tourId, pricingType, startDate])
  @@index([userId, createdAt])
}

model Payment {
  id          String   @id @default(uuid())
  bookingId   String  @unique
  xenditInvoiceId      String
  invoiceUrl   String
  status      PaymentStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id    String @id @default(uuid())
  starRating  Int
  comment     String
  // imageIds    String[]

  userId    String
  tourId    String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour    Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

}

model Hotel {
  id        String @id  @default(uuid())
  name      String  @unique
  address   String
  description String
  amenities String[]

  rooms     Room[]
  policies  Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        String @id  @default(uuid())
  name      String  @unique
  description String
  baseRate  Float
  maxOccupancy  Int
  roomType  RoomType
  bedType BedType
  extraPersonRate Int

  hotelId   String

  hotel   Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Policy {
  id        String @id @default(uuid())
  checkIn   String
  checkOut  String
  cancellation  String
  child     String
  reservation String
  pet String

  hotelId String

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RoomType {
  STUDIO
  ENTIRE_HOUSE
  LUXURY
  FAMILY
}

enum BedType {
  DOUBLE
  KING
  QUEEN
}

enum TourType {
  DAY
  PACKAGE
}

enum TourSchedule {
  MORNING
  AFTERNOON
  EVENING
  WHOLE_DAY
}

enum PricingType {
  JOINER
  PRIVATE
}

enum Role {
  USER
  ADMIN
}

enum ImageType {
  TOUR
  ITINERARY
  PROFILE
}

enum ImageStatus {
  TEMP
  ACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

