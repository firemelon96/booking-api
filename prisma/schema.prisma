// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "postgresql"
}

//================================
// USER TABLE
//================================
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  role     Role    @default(USER)
  emailVerified Boolean @default(false)

  profileImageId String? @unique
  profileImage   Image?  @relation("UserProfileImage", fields: [profileImageId], references: [id])

  accounts Account[]
  sessions Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]

  bookings Booking[]
  reviews  Review[]

  likedService  ServiceLike[]

  accommodations  Accommodation[]
  tours Tour[]
  transfers Transfer[]
  rentals Rental[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  ip           String?
  userAgent    String?
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id  String @id @default(uuid())
  token String @unique
  userId  String
  expiresAt DateTime

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AdminAction {
  OVERBOOKING
  FORCED_PRIVATE
  BOOKED_ON_CLOSED_DATE
  FORCED_JOINER
  EXCEED_CAPACITY
}

model AdminWarningLog{
  id  String  @id @default(uuid())

  actionType  AdminAction
  message   String

  accommodationId String?
  unitId   String?
  tourId    String?
  transferId  String?
  rentalId String?
  bookingId String?

  actorId String

  metadata  Json

  createdAt DateTime @default(now())
}

//================================
// TOUR TABLES
//================================
model Tour {
  id             String @id @default(uuid())
  name           String
  slug           String @unique
  joinerCapacity Int    @default(12)

  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  description  String?
  highlights   String[]
  location     String
  durationDays Int? //For day tours, this will be 1 day. For package tours, this will be the total duration of the tour in days.
  capacityMode CapacityMode @default(MIXED)
  type         TourType     @default(DAY)
  timezone     String       @default("Asia/Manila")

  hasSchedule Boolean @default(false) //type day

  schedules          TourScheduleOption[] //For package tours, this will be empty and the schedule will be determined by the itinerary.

  itinerary          Itinerary?
  cancellationPolicy CancellationPolicy?

  inclusions         TourInclusion[]
  exclusions         TourExclusion[]
  images             Image[]
  pricing            TourPricing[]
  reviews            Review[]
  availability       TourAvailability[]
  capacity           TourDailyCapacity[]
  
  tourBookings       TourBooking[]

  likes              ServiceLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TourInclusion {
  id   String @id @default(uuid())

  title String
  description String?

  sortOrder Int @default(0)

  tourId String
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId])
}

model TourExclusion {
  id   String @id @default(uuid())

  title String
  description String?

  sortOrder Int @default(0)

  tourId String
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId])
}

model  ServiceLike {
  id  String @id @default(uuid())

  serviceType ServiceType

  userId  String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  tourId  String?
  tour  Tour?  @relation(fields: [tourId], references: [id], onDelete: Cascade)

  transferId String?
  transfer Transfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)

  accommodationId String?
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  unitId String
  unit AccommodationUnit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  rentalItemId String?
  item RentalItem? @relation(fields: [rentalItemId] , references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([userId, serviceType])
}

//================================
// AVAILABILITY TABLE
//================================
model TourAvailability {
  id   String   @id @default(uuid())
  date DateTime

  isClosed Boolean @default(false) //If true, the tour is not available for booking on this date. This can be used for maintenance, fully booked dates, etc.
  tourId   String
  reason   String? //e.g. "Maintenance", "Fully Booked", etc.
  tour     Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tourId, date])
}

//===============================
// TOUR DAILY CAPACITY
//===============================
model TourDailyCapacity {
  id String @id @default(uuid())

  date     DateTime
  capacitySlots Int
  bookedSlots   Int      @default(0) // current used slots

  scheduleId String?
  schedule   TourScheduleOption? @relation(fields: [scheduleId], references: [id])

  scheduleKey String

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tourId, date, scheduleKey])
}

//================================
// SCHEDULE TABLE
//================================
model TourScheduleOption {
  id String @id @default(uuid())

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  label     String
  startTIme String?
  endTime   String?

  maxParticipants Int?

  capacities TourDailyCapacity[]
  tourBookings TourBooking[]

  createdAt DateTime @default(now())
}

//================================
// ITINERARY TABLES
//================================
model Itinerary {
  id   String         @id @default(uuid())
  days ItineraryDay[]

  tourId String @unique
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItineraryDay {
  id        String  @id @default(uuid())
  dayNumber Int
  title     String?

  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  items ItineraryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItineraryItem {
  id          String  @id @default(uuid())
  time        String //Can be a specific time (e.g. 9:00 AM) or a time range (e.g. 9:00 AM - 11:00 AM) or a general time of day (e.g. Morning, Afternoon, Evening)
  title       String
  description String?

  order Int

  dayId String
  day   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//================================
// IMAGE TABLES
//================================
model Image {
  id         String  @id @default(uuid())
  url        String
  publicId   String
  isFeatured Boolean @default(false)

  type   ImageType
  status ImageStatus @default(TEMP) //for cleanup

  tourId String?
  tour      Tour?    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  transferId  String?
  transfer Transfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)

  rentalId String?
  rental Rental? @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  rentalItemId String?
  item RentalItem? @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)

  accommodationId String?
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  unitId  String?
  unit AccommodationUnit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  reviewId String?
  review Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userProfile User? @relation("UserProfileImage")

  createdAt DateTime @default(now())
}

//================================
// PRICING TABLES
//================================
model TourPricing {
  id String @id @default(uuid())

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  pricingType PricingType

  pricingModel PricingModel

  price Float

  minGroupSize Int
  maxGroupSize Int

  createdAt DateTime @default(now())
}

model CancellationPolicy {
  id          String @id @default(uuid())
  description String?

  fullRefundHours Int 
  partialRefundHours    Int 
  partialRefundPercentage      Int 

  tourId String @unique
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id  String  @id @default(uuid())

  reference String @unique
  type ServiceType

  userId  String
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingStatus BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  totalPrice  Decimal @db.Decimal(12,2)

  paidAmount  Decimal @db.Decimal(12,2) @default(0)

  remainingBalance  Decimal @db.Decimal(12,2) @default(0)

  expiresAt DateTime?

  cancelledAt DateTime?
  cancellationReason  String?

  isAdminOverride Boolean @default(false)

  rescheduleCount    Int       @default(0)
  lastRescheduleDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cancellationRefundType CancellationRefundType?
  cancellationRefundPercentage  Int?
  refundAmount Decimal? @db.Decimal(12,2)
  refundStatus RefundStatus?

  tourBooking TourBooking?

  accommodationBooking AccommodationBooking?

  transferBooking TransferBooking?

  rentalBooking RentalBooking?

  payment PaymentTransation[]

  auditLog  BookingAuditLog[]
}

//================================
// BOOKING TABLES
//================================
model TourBooking {
  id String @id @default(uuid())

  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  tourId String
  tour     Tour  @relation(fields: [tourId], references: [id])

  pricingType  PricingType
  participants Int

  startDate DateTime
  endDate   DateTime?

  notes        String?

  scheduleId String?
  schedule TourScheduleOption? @relation(fields: [scheduleId], references: [id]) 
  
  isOverbooked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId, startDate, endDate])
}

//================================
//BOOKING HISTORY TABLES
//================================
model BookingAuditLog {
  id            String        @id @default(uuid())

  bookingId     String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  actorId       String? //userid
  actorType     Role //USER or ADMIN
  action        BookingAction //e.g. CREATED, RESCHEDULED, CANCELLED
  previousValue Json? //e.g. previous start date for rescheduling, or previous status for cancellation
  newValue      Json? //e.g. new start date for rescheduling, or new status for cancellation
  reason        String? //for cancellation or rescheduling

  timestamp DateTime @default(now())

  createdAt DateTime @default(now())

}

//================================
// PAYMENT TABLES
//================================
model PaymentTransation {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type TransactionType

  amount Decimal @db.Decimal(12,2)

  paidAt  DateTime?
  description String?
  expiresAt DateTime?

  xenditInvoiceId String?
  invoiceUrl      String?

  metadata  Json?

  paymentStatus          PaymentStatus @default(PENDING)

}

enum TransactionType {
  INITIAL_PAYMENT
  ADDITIONAL_PAYMENT
  REFUND
  MANUAL_ADJUSTMENT
}

//================================
// REVIEW TABLES
//================================
model Review {
  id         String @id @default(uuid())
  starRating Int
  comment    String
  imageIds    String[]

  userId String
  tourId String?
  transferId String?
  accommodationId String?
  unitId String?
  rentalItemId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour? @relation(fields: [tourId], references: [id], onDelete: Cascade)
  transfer Transfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  unit AccommodationUnit? @relation(fields: [unitId], references: [id], onDelete: Cascade)
  rentalItem RentalItem? @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Accommodation {
  id          String   @id @default(uuid())

  name        String   
  slug        String  @unique

  type        AccommodationType
  
  description String?

  address String?
  city  String?
  province  String?
  country   String?

  latitude  Float?
  longitude Float?

  checkInTime String?
  checkOutTime  String?

  hasUnits  Boolean @default(false)

  isBookable Boolean @default(false)

  maxGuests  Int?

  basePrice Decimal? @db.Decimal(10,2)

  status  AccommodationStatus @default(DRAFT)

  ownerId String
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  units AccommodationUnit[]

  images Image[]

  amenities AccommodationAmenity[]

  bookings  AccommodationBooking[]

  inventory AccommodationInventory[]

  likes ServiceLike[]

  reviews Review[]

  cancellationPolicy  AccommodationCancellationPolicy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccommodationUnit {
  id    String  @id @default(uuid())

  accommodationId String
  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  name  String
  slug String
  description String?

  maxAdult Int
  maxChildren Int?

  bedrooms Int?
  bathrooms Int?

  quantity  Int @default(1)

  basePrice Decimal @db.Decimal(10,2)

  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt

  inventories AccommodationUnitInventory[]

  bookings  AccommodationBooking[]

  amenities  AccommodationUnitAmenity[]

  images Image[]

  reviews Review[]

  likes ServiceLike[]

  @@unique([accommodationId, slug])
}

model Amenity {
  id  String @id @default(uuid())

  name  String  @unique
  slug  String  @unique

  icon  String?

  createdAt DateTime  @default(now())

  accommodations  AccommodationAmenity[]

  rentals RentalAmenity[]

  transfers TransferAmenity[]

  units AccommodationUnitAmenity[]
}

model AccommodationAmenity {
  accommodationId String
  amenityId String

  accomodation  Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([accommodationId, amenityId])
}

model AccommodationUnitAmenity {
  unitId  String
  amenityId String

  unit AccommodationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([unitId, amenityId])
}

model AccommodationInventory{
  id  String @id @default(uuid())

  accommodationId  String
  accommodation  Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  date  DateTime

  availableUnits Int
  bookedUnits Int @default(1)

  overridePrice Decimal? @db.Decimal(10,2)

  isClosed Boolean @default(false)

  @@unique([accommodationId, date])
}

model AccommodationUnitInventory{
  id  String @id @default(uuid())

  unitId  String
  unit  AccommodationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  date  DateTime

  availableUnits Int
  bookedUnits Int @default(1)

  overridePrice Decimal? @db.Decimal(10,2)

  isClosed Boolean @default(false)

  @@unique([unitId, date])
}

model AccommodationBooking {
  id  String  @id @default(uuid())

  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  accommodationId String
  accommodation Accommodation @relation(fields: [accommodationId], references: [id])

  unitId  String?
  unit  AccommodationUnit? @relation(fields: [unitId], references: [id])

  checkIn DateTime
  checkOut  DateTime

  nights  Int

  guests Int

  units Int 

  specialRequests String?

  isOverbooked Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AccommodationCancellationPolicy{
  id  String @id  @default(uuid())

  description String?

  fullRefundDays  Int
  partialRefundDays Int

  partialRefundPercentage Int

  accommodationId String  @unique
  accommodation Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Transfer {
  id  String @id @default(uuid())
  name  String
  slug  String @unique

  description String?
  type TransferType

  pricingMode TransferPricingMode

  originId  String
  origin TransferLocation @relation("TransferOrigin", fields: [originId], references: [id])
  destinationId String
  destination TransferLocation @relation("TransferDestination", fields: [destinationId], references: [id])
  
  hasSchedule Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  

  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  schedules TransferSchedule[]

  inventories TransferInventory[]

  pricing TransferPricing[]

  amenities TransferAmenity[]

  bookings TransferBooking[]

  likes ServiceLike[]

  reviews Review[]

  images Image[]
}

model TransferAmenity {
  transferId String
  transfer  Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  amenityId String
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([transferId, amenityId])
}

model TransferLocation {
  id  String @id @default(uuid())

  name  String

  type TransferLocationType

  address String?

  latitude Decimal?
  longitude Decimal?

  createdAt DateTime @default(now())

  originTransfers Transfer[] @relation("TransferOrigin")

  destinationTransfers Transfer[] @relation("TransferDestination")
}

model TransferSchedule {
  id  String @id @default(uuid())

  transferId  String
  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  departureTime String

  maxPassengers Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  inventories TransferInventory[]

  transferBookings TransferBooking[]
}

model TransferInventory {
  id  String @id @default(uuid())

  transferId String
  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  scheduleId String?
  schedule TransferSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  date  DateTime

  availableSeats  Int
  bookedSeats Int @default(0)

  isClosed Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([transferId, scheduleId, date])
}

model TransferPricing {
  id String @id @default(uuid())

  transferId  String
  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  pricingType PricingType

  price Decimal @db.Decimal(12,2)

  minPassengers Int
  maxPassengers Int

  createdAt DateTime @default(now())
}

model TransferBooking {
  id  String @default(uuid())

  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  transferId String
  transfer Transfer @relation(fields: [transferId], references: [id])

  scheduleId String?
  schedule TransferSchedule? @relation(fields: [scheduleId], references: [id])

  date  DateTime

  passengers Int

  pricingType PricingType

  pickupLocation  String?
  dropoffLocation String?

  createdAt DateTime @default(now())
}

enum TransferType {
  AIRPORT
  VAN
  BOAT
  FERRY
  PRIVATE_CAR
}

enum TransferPricingMode {
  SHARED
  EXCLUSIVE
}

enum TransferLocationType {
  AIRPORT
  PORT
  TERMINAL
  HOTEL
  CUSTOM
}

model Rental {
  id String @id @default(uuid())

  ownerId String
  owner User @relation(fields: [ownerId], references: [id])

  name String
  slug String @unique

  description String?

  type RentalType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentalItems RentalItem[]

  amenities RentalAmenity[]

  images Image[]
}

model RentalItem {
  id String @id @default(uuid())

  rentalId String
  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  name String
  description String?

  itemCode String

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories RentalInventory[]

  pricing RentalPricing[]

  bookings RentalBooking[]

  likes ServiceLike[]

  reviews Review[]

  images Image[]

  @@unique([rentalId, itemCode])
  @@index([rentalId])
}

model RentalInventory {
  id String @id @default(uuid())

  rentalItemId String
  rentalItem RentalItem @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)

  date DateTime

  availableUnits Int

  bookedUnits Int @default(0)

  isClosed Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([rentalItemId, date])
}

model RentalPricing {
  id String @id @default(uuid())

  rentalItemId String
  rentalItem RentalItem @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)

  pricingType RentalPricingType

  price Decimal @db.Decimal(12,2)

  createdAt DateTime @default(now())
}

model RentalBooking {
  id String @id  @default(uuid())

  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete:  Cascade)

  rentalItemId String
  item RentalItem @relation(fields: [rentalItemId], references: [id])

  startDate DateTime
  endDate DateTime

  quantity Int

  pricingType RentalPricingType

  pickupLocation String?
  returnLocation String?

  hasOverbooking Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RentalAmenity {
  rentalId String
  amenityId String

  rental Rental @relation(fields: [rentalId], references: [id], onDelete:  Cascade)

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([rentalId, amenityId])
}

enum RentalType {
  MORTORBIKE
  SCOOTER
  CAR
  VAN
  BICYCLE
  KAYAK
  CAMPING_GEAR
  BOAT
  OTHER
}

enum RentalPricingType {
  HOURLY
  DAILY
  WEEKLY
}

enum ServiceType {
  TOUR
  ACCOMMODATION
  TRANSFER
  RENTAL
}

enum AccommodationType {
  HOTEL
  RESORT
  INN
  APARTMENT
  HOUSE
  VILLA
  HOMESTAY
  HOSTEL
}

enum AccommodationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


enum BookingAction {
  CREATED
  RESCHEDULED
  CANCELLED
  PAYMENT_WEBHOOK_UPDATED
}

enum TourType {
  DAY
  PACKAGE
}

enum CapacityMode {
  EXCLUSIVE
  SHARED
  MIXED
}

enum TourSchedule {
  MORNING
  AFTERNOON
