// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String?
  googleId String?  @unique
  name    String?
  role     Role     @default(USER)

  profileImageId  String? @unique
  profileImage  Image? @relation("UserProfileImage",fields: [profileImageId], references: [id])

  bookings Booking[]
}

model Tour {
  id      String        @id @default(uuid())
  name    String
  slug    String        @unique
  joinerCapacity Int @default(12)

  description String
  highlights String[]
  inclusions String[]
  exclusions String[]
  location    String
  durationDays    Int? //For day tours, this will be null. For package tours, this will be the total duration of the tour in days.
  types       TourType  @default(DAY)  

  schedules   TourScheduleOption[] //For package tours, this will be empty and the schedule will be determined by the itinerary.
  images  Image[]
  pricing TourPricing[]
  bookings Booking[]
  itineraries Itinerary[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model TourScheduleOption {
  id      String      @id @default(uuid())
  schedule TourSchedule 

  tourId  String
  tour    Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)

  bookings Booking[] //For package tours, this will be empty and the schedule will be determined by the itinerary.

  createdAt DateTime    @default(now())
}

model Itinerary {
  id      String      @id @default(uuid())
  title   String
  activities  String[]
  destinations  String[]

  tourId  String
  tour    Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Image {
  id          String      @id @default(uuid())
  url         String
  publicId    String
  isFeatured  Boolean     @default(false)

  type        ImageType
  status      ImageStatus @default(TEMP) //for cleanup

  tourId      String?
 
  userProfile User? @relation("UserProfileImage")

  tour        Tour?       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
}

model TourPricing {
  id           String   @id @default(uuid())
  pricingType  PricingType
  minGroupSize Int
  maxGroupSize Int
  price        Float
  tourId       String
  isGroupPrice Boolean @default(false) //For joiner tours, this will be true. For private tours, this will be false.
  tour         Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  tourId    String

  pricingType PricingType
  participants Int

  totalPrice     Float
  status         BookingStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime?

  scheduleId String? //For package tours, this will be null and the schedule will be determined by the itinerary.

  payments Payment?
  
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Restrict)
  schedule TourScheduleOption? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId, startDate])
  @@index([tourId, pricingType, startDate])
  @@index([userId, createdAt])
}

model Payment {
  id          String   @id @default(uuid())
  bookingId   String  @unique
  xenditInvoiceId      String
  invoiceUrl   String
  status      PaymentStatus @default(PENDING)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum TourType {
  DAY
  PACKAGE
}

enum TourSchedule {
  MORNING
  AFTERNOON
  EVENING
  WHOLE_DAY
}

enum PricingType {
  JOINER
  PRIVATE
}

enum Role {
  USER
  ADMIN
}

enum ImageType {
  TOUR
  ITINERARY
  PROFILE
}

enum ImageStatus {
  TEMP
  ACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

